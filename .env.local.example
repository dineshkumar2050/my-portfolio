# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# ─── Email (Resend) ────────────────────────────────────────────────
# Sign up free at https://resend.com
# For testing without a custom domain, leave RESEND_FROM_EMAIL as-is (uses onboarding@resend.dev)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
# Once you have a verified domain: RESEND_FROM_EMAIL=portfolio@yourdomain.com

# ─── AI Chatbot (Google Gemini) ───────────────────────────────────
# Get your API key at https://aistudio.google.com/app/api-keys
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional fallback if Gemini is unavailable
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OTP / session signing ────────────────────────────────────────
# Any long random string (e.g. `openssl rand -base64 32`). Signs OTP and tailored-resume session tokens.
OTP_SIGNING_SECRET=change-me-to-a-long-random-string

# ─── Tailored resume agents (LangGraph) ───────────────────────────
# Primary: Claude Haiku via ANTHROPIC_API_KEY (https://platform.claude.com → API Keys).
# Falls back to GOOGLE_API_KEY (Gemini), then GROQ_API_KEY. Optional model overrides:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# RESUME_AGENT_CLAUDE_MODEL=claude-haiku-5-5
# RESUME_FLEX_THRESHOLD=50   # profile-fit % at which agents may claim related JD skills
# RESUME_AGENT_GEMINI_MODEL=gemini-3.6-flash
# RESUME_AGENT_GROQ_MODEL=openai/gpt-oss-20b

# Job-URL readers (optional, tried in this order when a job board blocks direct access;
# leave any of them empty to skip it). LinkedIn and Naukri use their free public APIs first.
APIFY_API_TOKEN=          # https://console.apify.com/settings/integrations — used for Indeed
SCRAPINGBEE_API_KEY=      # https://app.scrapingbee.com/dashboard
SCRAPERAPI_KEY=           # https://dashboard.scraperapi.com
# APIFY_INDEED_ACTOR=misceres~indeed-scraper

# LangSmith tracing (optional) — https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=portfolio-tailored-resume

# ─── Portfolio URL (used in email links) ──────────────────────────
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000
# In production: NEXT_PUBLIC_PORTFOLIO_URL=https://your-portfolio-domain.com

# ─── Notes ────────────────────────────────────────────────────────
# Without RESEND_API_KEY:  OTPs are printed to the server console (dev mode)
# Without GOOGLE_API_KEY: Chat shows "not configured" message
# The app works without these keys — features gracefully degrade
APIFY_API_TOKEN=
SCRAPINGBEE_API_KEY=
SCRAPERAPI_KEY=